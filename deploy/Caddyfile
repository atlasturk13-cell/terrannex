# TLS terminator for the self-hosted profile. Caddy obtains and renews the
# certificate automatically once SITE_ADDRESS resolves to this host and ports
# 80/443 are reachable. Everything is forwarded to the game image's nginx.
{$SITE_ADDRESS} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy game:8080 {
		header_up X-Forwarded-Proto {scheme}
	}
}
