{
  "name": "front-wars-local",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.19.0"
  },
  "scripts": {
    "build": "pnpm build:local",
    "build-dev": "concurrently \"tsc --noEmit\" \"vite build --mode development\"",
    "build-prod": "concurrently --kill-others-on-fail \"tsc --noEmit\" \"vite build\"",
    "build:local": "cross-env LOCAL_ONLY=true concurrently --kill-others-on-fail \"tsc --noEmit\" \"vite build\"",
    "build:static": "tsx src/scripts/build-static-site.ts",
    "build:vercel": "pnpm build:local && pnpm build:static",
    "local": "cross-env LOCAL_ONLY=true GAME_ENV=dev SKIP_BROWSER_OPEN=true vite --host 127.0.0.1 --port 5173",
    "start:client": "vite",
    "start": "pnpm start:server",
    "start:server": "tsx src/server/Server.ts",
    "start:server-dev": "cross-env LOCAL_ONLY=true GAME_ENV=dev SESSION_SECRET=local-dev-session-secret-not-for-production-use NUM_WORKERS=2 TURNSTILE_SITE_KEY=1x00000000000000000000AA DOMAIN=localhost TRUST_PROXY_HOPS=1 GIT_COMMIT=DEV tsx src/server/Server.ts",
    "start:prod": "cross-env LOCAL_ONLY=true GAME_ENV=dev NUM_WORKERS=2 TURNSTILE_SITE_KEY=1x00000000000000000000AA DOMAIN=localhost TRUST_PROXY_HOPS=1 tsx src/server/Server.ts",
    "dev": "cross-env GAME_ENV=dev concurrently \"pnpm start:client\" \"pnpm start:server-dev\"",
    "dev:host": "sh scripts/assert-release-ready.sh",
    "dev:staging": "sh scripts/assert-release-ready.sh",
    "dev:prod": "sh scripts/assert-release-ready.sh",
    "docs:map-generator": "cd map-generator && go doc -cmd -u -all",
    "tunnel": "sh scripts/assert-release-ready.sh",
    "test": "vitest run --maxWorkers=1 && vitest run tests/server --maxWorkers=1",
    "test:matchmaking": "node tests/matchmaking/contained.mjs",
    "test:matchmaking:e2e": "node tests/matchmaking/e2e.mjs",
    "test:matchmaking:cancel": "node tests/matchmaking/e2e-cancel.mjs",
    "perf": "pnpm exec tsx tests/perf/run-all.ts",
    "perf:game": "pnpm exec tsx tests/perf/fullgame/FullGamePerf.ts",
    "replay:game": "pnpm exec tsx tests/replay/ReplayGame.ts",
    "perf:client": "pnpm exec tsx tests/perf/client/ClientUpdatePerf.ts",
    "perf:client-mem": "pnpm exec tsx tests/perf/client/ClientMemoryPerf.ts",
    "perf:client-tick": "pnpm exec tsx tests/perf/client/ClientTickPerf.ts",
    "test:coverage": "vitest run --coverage --maxWorkers=1",
    "format": "prettier --ignore-unknown --write .",
    "format:map-generator": "cd map-generator && go fmt .",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:fix": "pnpm lint:oxlint:fix && pnpm lint:eslint:fix",
    "lint:oxlint": "oxlint",
    "lint:oxlint:fix": "oxlint --fix",
    "lint:github": "oxlint --format=github && eslint --format gha",
    "lint:eslint": "eslint",
    "lint:eslint:fix": "eslint --fix",
    "prepare": "husky",
    "gen-map:natural-earth": "sh scripts/generate-natural-earth-world.sh",
    "gen-map:natural-earth-regions": "sh scripts/generate-natural-earth-regions.sh",
    "gen-maps": "cd map-generator && go run . && pnpm format",
    "inst": "pnpm install --frozen-lockfile --ignore-scripts",
    "domain": "sh scripts/set-domain.sh"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,ts,jsx,tsx}": [
      "oxlint --fix",
      "eslint --fix"
    ],
    "**/*": [
      "prettier --ignore-unknown --write"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@lit-labs/virtualizer": "^2.1.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/benchmark": "^2.1.5",
    "@types/d3": "^7.4.3",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/hammerjs": "^2.0.46",
    "@types/howler": "^2.2.12",
    "@types/msgpack5": "^3.4.6",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "benchmark": "^2.1.4",
    "canvas": "^3.2.3",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "d3": "^7.9.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-gha": "^2.0.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "lit": "^3.3.2",
    "marked": "^18.0.5",
    "mrmime": "^2.0.1",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-sh": "^0.18.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.16",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^4.1.5",
    "vitest-canvas-mock": "^1.1.4"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.216.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@opentelemetry/winston-transport": "^0.26.0",
    "@types/compression": "^1.8.1",
    "colord": "^2.9.3",
    "compression": "^1.8.1",
    "dompurify": "^3.4.13",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "howler": "^2.2.4",
    "intl-messageformat": "^11.2.3",
    "ip-anonymize": "^0.1.0",
    "jose": "^6.2.3",
    "lil-gui": "^0.21.0",
    "limiter": "^3.0.0",
    "nanoid": "^5.1.16",
    "node-html-parser": "^7.1.0",
    "obscenity": "^0.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "winston": "^3.19.0",
    "ws": "^8.21.0",
    "zod": "^4.4.2"
  },
  "type": "module"
}
